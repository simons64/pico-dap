.pio_version 0 // only requires PIO version 0

.program dap
; One side-set bit, optional: 1 driven pin. SIDE_EN counts as one of the
; two side-set field bits, so `.side_set 1 opt` drives exactly one pin.
.side_set 1 opt

; DAP output: data on the OUT pin, clock on the side-set pin.
; Data is shifted out LSB first, one clock pulse per data bit.
; Clock idles low.
    pull             side 0 [1]  ; wait for the next 32-bit word, clock low
    set x, 31        side 0 [1]  ; 32 data bits per FIFO word
bitloop:
    out pins, 1      side 0 [1]  ; drive data bit, clock low
    nop              side 1 [3]  ; clock high (4 cycles)
    jmp x-- bitloop  side 0 [1]  ; clock low (2 + 2 cycles from OUT)


% c-sdk {
#include "hardware/clocks.h"

static inline void dap_program_init(PIO pio, uint sm, uint offset, uint pin_data, uint pin_clk, uint freq_hz) {
    // Data idles high, clock idles low. Set the output latches and directions
    // before mapping PIO onto the pins with the IO muxes.
    uint32_t pins_mask = (1u << pin_data) | (1u << pin_clk);
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << pin_data, pins_mask);
    pio_sm_set_pindirs_with_mask64(pio, sm, pins_mask, pins_mask);
    pio_gpio_init(pio, pin_data);
    pio_gpio_init(pio, pin_clk);

    pio_sm_config c = dap_program_get_default_config(offset);

    // OUT shifts to right (LSB first), no autopull
    sm_config_set_out_shift(&c, true, false, 32);

    // Data on the OUT pin group, clock on the side-set pin group.
    sm_config_set_out_pins(&c, pin_data, 1);
    sm_config_set_sideset_pins(&c, pin_clk);

    // We only need TX, so get an 8-deep FIFO!
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    // One data bit (one clock period) takes 8 SM cycles, so
    //     freq_hz = clk_sys / (div * 8)
    // The divider is 16.8 fixed point and only valid in [1, 65536]. Clamp
    // explicitly: sm_config_set_clkdiv() merely asserts (compiled out in
    // release) and otherwise truncates an out-of-range value modulo 2^16,
    // silently producing a completely different frequency.
    float div = (float)clock_get_hz(clk_sys) / (8.0f * (float)freq_hz);
    if (div < 1.0f) div = 1.0f;
    if (div > 65536.0f) div = 65536.0f;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void uart_tx_program_putc(PIO pio, uint sm, char c) {
    pio_sm_put_blocking(pio, sm, (uint32_t)c);
}

static inline void uart_tx_program_puts(PIO pio, uint sm, const char *s) {
    while (*s)
        uart_tx_program_putc(pio, sm, *s++);
}

%}
