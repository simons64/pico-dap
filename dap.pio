.pio_version 0 // only requires PIO version 0

.program dap
.side_set 1 opt
    ; might be a good idea to clock back to default ?


    set pindirs, 1     side 0 ; data pin OUTPUT

    ; metadata: tx len [bits]
    pull               
    out x, 7           
    out y, 7
    
next_word:
    pull               ; next word; stalls while the FIFO is empty

bit_loop:
    out pins, 1          side 0 [1] ; 2 clock cycles low
    jmp x-- more         side 1     ;
    jmp done             side 1     ;
more:
    jmp !osre bit_loop   side 1     ;
    jmp next_word        side 0     ;
done:


    ; Data pin becomes an input: the PIO stops driving DAP1 so the target can.
    set pindirs, 0         side 0 [7]

    ; Clear the ISR before the wait loop, not after the start bit: the reply's
    ; start bit is its first bit, so nothing may be clocked in before the input
    ; shift counter is back at 0.
    mov isr, null          side 0

    ; Wait for the reply's start bit on DAP1. Sample it while the clock is LOW:
    ; the target presents each bit ~40 ns after a rising edge, so a low-phase
    ; sample sees the bit that the *previous* edge produced. Jumping straight
    ; into the loop body then lets `in` rise the clock and capture that same bit
    ; (an `in` samples at its first cycle, so it must also own the rising edge;
    ; if the jump rose the clock instead, the start bit would be clocked away).
    set x, 10   ; 10 is a random guess
wait_start_bit:
    jmp pin start_bit      side 0 [1]
    jmp x-- wait_start_bit side 1 [1]

start_bit:

rx_loop:
    in pins, 1             side 1 [1]
    push iffull            side 0
    jmp y-- rx_loop        side 0

    push

    ; Put the idle level (high) in the output latch *before* re-enabling the
    ; driver, otherwise re-driving would repeat the last data bit.
    set pins, 0        ; idle low while still an input
    set pindirs, 1     ; data pin OUTPUT again


% c-sdk {
#include "hardware/clocks.h"

static inline void dap_program_init(PIO pio, uint sm, uint offset, uint pin_data, uint pin_clk, uint freq_hz) {
    // Data idles high, clock idles low. Set the output latches and directions
    // before mapping PIO onto the pins with the IO muxes.
    uint32_t pins_mask = (1u << pin_data) | (1u << pin_clk);
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << pin_data, pins_mask);
    pio_sm_set_pindirs_with_mask64(pio, sm, pins_mask, pins_mask);
    pio_gpio_init(pio, pin_data);
    pio_gpio_init(pio, pin_clk);

    pio_sm_config c = dap_program_get_default_config(offset);

    // OUT shifts to right (LSB first), no autopull
    sm_config_set_out_shift(&c, true, false, 32);

    // Data on the OUT pin group, clock on the side-set pin group.
    sm_config_set_out_pins(&c, pin_data, 1);
    sm_config_set_sideset_pins(&c, pin_clk);

    sm_config_set_in_pins(&c, pin_data);
    sm_config_set_jmp_pin(&c, pin_data);

    // SET PINDIRS targets the same pin as OUT, so the program can switch the
    // data pin between output (driven bits) and input (released).
    sm_config_set_set_pins(&c, pin_data, 1);

    // 4 TX + 4 RX entries. The RX side is drained by DMA, so the 4-entry
    // depth does not limit the length of a response.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);

    // One data bit is 4 SM cycles in every phase: `out pins, 1 [1]` + `jmp` +
    // `jmp` in the transmit loop, `in pins, 1 [1]` + `push` + `jmp` in the
    // receive loop, and `jmp [1]` + `jmp [1]` in the start-bit hunt. So
    //     freq_hz = clk_sys / (div * 4)
    // and the divider has to be derived from 4, not 8, or the DAP clock comes out
    // at twice the requested rate. The divider is 16.8 fixed point and only valid
    // in [1, 65536]. Clamp explicitly: sm_config_set_clkdiv() merely asserts
    // (compiled out in release) and otherwise truncates an out-of-range value
    // modulo 2^16, silently producing a completely different frequency.
    float div = (float)clock_get_hz(clk_sys) / (4.0f * (float)freq_hz);
    if (div < 1.0f) div = 1.0f;
    if (div > 65536.0f) div = 65536.0f;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}
