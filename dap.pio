.pio_version 0 // only requires PIO version 0

.program dap
; One side-set bit, optional: 1 driven pin. SIDE_EN counts as one of the
; two side-set field bits, so `.side_set 1 opt` drives exactly one pin.
.side_set 1 opt

; DAP output: data on the OUT pin, clock on the side-set pin.
; Data is shifted out LSB first, one clock pulse per data bit.
; Clock idles low.
;
; Transaction shape (one 32-bit FIFO word per transaction):
;
;   clocks  1..20   data pin OUTPUT, bit shifted LSB-first out of the word
;   clocks 21..76   data pin INPUT (PIO releases it, the target may drive)
;   then            data pin OUTPUT again, line idles high, next word pulled
;
; Only the low 20 bits of each FIFO word are used; OUT shifts the word right,
; so bits 31:20 are discarded by the next PULL. Every clock period is 8 SM
; cycles in both phases, so the released phase runs at the same clock rate as
; the driven one (freq_hz = clk_sys / (div * 8) still holds).
    pull               side 0 [1]  ; next word; stalls while the FIFO is empty
    set pindirs, 1     side 0 [1]  ; data pin OUTPUT
    ; JMP X-- tests X before decrementing, so a loop entered with X = n runs
    ; n + 1 times: X = 19 - 1 gives the 18 driven clocks.
    
    set x, 5           side 0 [1]
cmd_loop:
    out pins, 1        side 0 [1]
    nop                side 1 [3]
    jmp x-- cmd_loop   side 0 [1]  ; clock low (2 + 2 cycles from OUT)


    mov isr, null
    set x, 5           side 0 [1]
cmd_loop2:
    in  osr, 1
    out pins, 1        side 0 [1]
    nop                side 1 [3]
    jmp x-- cmd_loop2  side 0 [1]  ; clock low (2 + 2 cycles from OUT)
    in  null, 26
    mov y, isr 

    set x, 6           side 0 [7]  ; 19 driven clocks
tx_loop:
    out pins, 1        side 0 [1]  ; drive data bit, clock low
    nop                side 1 [3]  ; clock high (4 cycles)
    jmp x-- tx_loop    side 0 [1]  ; clock low (2 + 2 cycles from OUT)


    ; Data pin becomes an input: the PIO stops driving DAP1 so the target can.
    set pindirs, 0     side 0 [2]  ; release the data pin
    
    ; wait for input start bit   
    set x, 10   ;
wait_start_bit:
    jmp pin start_bit      side 0 [2]  ; 
    jmp x-- wait_start_bit side 1 [2]  ; clock low

start_bit:
;    set x, 11              side 0 [7]  ;
;in_cmd_loop:
;    ;nop                   side 0 [1]  ; drive data bit, clock low
;    in  pins, 1            side 1 [3]  ; clock high (4 cycles)
;    jmp x-- in_cmd_loop    side 0 [2]  ; clock low (2 + 2 cycles from OUT)


    mov isr, null
rx_loop_a:
    in pins, 1         side 1 [3]  ; clock high (4 cycles)
    push iffull
    jmp y-- rx_loop_a  side 0 [2]  ; clock low

    push                      [1]

    ; Put the idle level (high) in the output latch *before* re-enabling the
    ; driver, otherwise re-driving would repeat the last data bit.
    set pins, 1        side 0 [1]  ; idle high while still an input
    set pindirs, 1     side 0 [1]  ; data pin OUTPUT again


% c-sdk {
#include "hardware/clocks.h"

static inline void dap_program_init(PIO pio, uint sm, uint offset, uint pin_data, uint pin_clk, uint freq_hz) {
    // Data idles high, clock idles low. Set the output latches and directions
    // before mapping PIO onto the pins with the IO muxes.
    uint32_t pins_mask = (1u << pin_data) | (1u << pin_clk);
    pio_sm_set_pins_with_mask64(pio, sm, 1ull << pin_data, pins_mask);
    pio_sm_set_pindirs_with_mask64(pio, sm, pins_mask, pins_mask);
    pio_gpio_init(pio, pin_data);
    pio_gpio_init(pio, pin_clk);

    pio_sm_config c = dap_program_get_default_config(offset);

    // OUT shifts to right (LSB first), no autopull
    sm_config_set_out_shift(&c, true, false, 32);

    // Data on the OUT pin group, clock on the side-set pin group.
    sm_config_set_out_pins(&c, pin_data, 1);
    sm_config_set_sideset_pins(&c, pin_clk);

    // SET PINDIRS targets the same pin as OUT, so the program can switch the
    // data pin between output (driven bits) and input (released).
    sm_config_set_set_pins(&c, pin_data, 1);

    // We only need TX, so get an 8-deep FIFO!
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_NONE);

    // One data bit (one clock period) takes 8 SM cycles, so
    //     freq_hz = clk_sys / (div * 8)
    // The divider is 16.8 fixed point and only valid in [1, 65536]. Clamp
    // explicitly: sm_config_set_clkdiv() merely asserts (compiled out in
    // release) and otherwise truncates an out-of-range value modulo 2^16,
    // silently producing a completely different frequency.
    float div = (float)clock_get_hz(clk_sys) / (8.0f * (float)freq_hz);
    if (div < 1.0f) div = 1.0f;
    if (div > 65536.0f) div = 65536.0f;
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

static inline void uart_tx_program_putc(PIO pio, uint sm, char c) {
    pio_sm_put_blocking(pio, sm, (uint32_t)c);
}

static inline void uart_tx_program_puts(PIO pio, uint sm, const char *s) {
    while (*s)
        uart_tx_program_putc(pio, sm, *s++);
}

%}
